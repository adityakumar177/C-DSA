// Program to insert element 10, 20 and 30 in a queue
#include <stdio.h>

int main()
{
    int queue[5];
    int rear = -1;

    queue[++rear] = 10;
    queue[++rear] = 20;
    queue[++rear] = 30;

    printf("Queue: ");

    for(int i = 0; i <= rear; i++)
        printf("%d ", queue[i]);

    return 0;
}
